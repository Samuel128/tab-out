{
  "proxy-groups": [
    {
      "name": "PROXY",
      "type": "select",
      "proxies": ["DIRECT", "Sanitized Node"]
    }
  ],
  "rules": [
    "DOMAIN-SUFFIX,existing.example,DIRECT",
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
    "MATCH,PROXY"
  ]
}
